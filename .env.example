# Токен бота от @BotFather
BOT_TOKEN=

# Твой Telegram ID (узнать у @userinfobot), можно несколько через запятую
ADMIN_IDS=

# Адрес панели 3x-ui вместе с секретным путём (webBasePath), без / в конце
PANEL_URL=https://1.2.3.4:28378/secretpath
# API-токен панели: Настройки → Безопасность → API Token
PANEL_TOKEN=
# false, если у панели самоподписанный сертификат или вход по IP
PANEL_VERIFY_SSL=false

# ID инбаунда, в который бот добавляет клиентов (колонка ID в списке инбаундов)
INBOUND_ID=1

# Публичный IP или домен сервера
SERVER_HOST=1.2.3.4

# Необязательно: ссылка подписки 3x-ui без subId на конце, например https://1.2.3.4:2096/sub/
# SUB_URL=

# Необязательно: токен ЮKassa из @BotFather → Payments. Если пусто — только Stars
# YOOKASSA_TOKEN=

# Пробный период в днях (0 — выключен)
TRIAL_DAYS=3

# Рефералка: дней пригласившему за первую оплату друга и дней другу к первой покупке
REF_BONUS_DAYS=7
REF_FRIEND_DAYS=3

DB_PATH=bot.db
